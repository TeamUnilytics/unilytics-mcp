{
  "name": "@unilytics/mcp-server",
  "version": "1.1.1",
  "description": "Connect Claude and other MCP clients to Unilytics: your saved skills, client context and Knowledge Base, and SEO, content and AEO research tools",
  "type": "module",
  "bin": {
    "unilytics-mcp-server": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const f='dist/index.js';const c=fs.readFileSync(f,'utf8');if(!c.startsWith('#!')){fs.writeFileSync(f,'#!/usr/bin/env node\\n'+c)}\"",
    "prepare": "npm run build",
    "test": "npm run build && node --test tests/bridge.test.mjs",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "test:mcpb": "node scripts/smoke-mcpb.mjs",
    "test:live": "node scripts/check-live-contract.mjs && node scripts/check-readme-tools.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.12",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "mcp",
    "claude",
    "marketing",
    "seo",
    "analytics",
    "unilytics"
  ],
  "author": "Unilytics <admin@univsense.com>",
  "license": "MIT",
  "homepage": "https://unilytics.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/TeamUnilytics/unilytics-mcp"
  }
}
